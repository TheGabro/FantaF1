{"nodes": [{"id": "airflow_docker_compose_airflow_common", "label": "x-airflow-common (shared Airflow service template)", "file_type": "code", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 3-27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YAML anchor merged into every Airflow container so image (apache/airflow:3.3.1-python3.12), env (LocalExecutor, metadata DB conn, FANTAF1_DATABASE_URL, auth manager, Execution API URL, JWT secret), volumes (dags/logs/plugins/config/auth) and the postgres healthy dependency are declared once."}, {"id": "airflow_docker_compose_postgres", "label": "postgres (Airflow metadata DB service)", "file_type": "code", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 30-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgres:16 backing the Airflow metadata database; pg_isready healthcheck gates every Airflow container via depends_on service_healthy."}, {"id": "airflow_docker_compose_airflow_init", "label": "airflow-init (db migrate + passwords.json bootstrap)", "file_type": "code", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 43-51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-shot container: runs `airflow db migrate` then writes /opt/airflow/auth/passwords.json from AIRFLOW_ADMIN_USERNAME/PASSWORD so the SimpleAuthManager has credentials. Other services wait on service_completed_successfully."}, {"id": "airflow_docker_compose_airflow_webserver", "label": "airflow-webserver (api-server, port 8080)", "file_type": "code", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 53-63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the Airflow 3 `api-server` command (UI + REST + Execution API) exposed on host port 8080; named 'webserver' for familiarity though Airflow 3 replaced the webserver with api-server."}, {"id": "airflow_docker_compose_airflow_scheduler", "label": "airflow-scheduler", "file_type": "code", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 65-73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs `scheduler`; with LocalExecutor the task workers run inside this container and must reach the Execution API on airflow-webserver."}, {"id": "airflow_docker_compose_airflow_dag_processor", "label": "airflow-dag-processor", "file_type": "code", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 75-83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs `dag-processor`, a separate mandatory component in Airflow 3 (parsing DAGs from ./dags is no longer done by the scheduler)."}, {"id": "airflow_docker_compose_postgres_db_volume", "label": "postgres-db-volume (named volume)", "file_type": "code", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 85-86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "airflow_docker_compose_execution_api", "label": "Airflow 3 Execution API (task-to-server communication)", "file_type": "rationale", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 14-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In Airflow 3 tasks no longer talk to the metadata DB directly; they go through the Execution API exposed by the api-server. AIRFLOW__CORE__EXECUTION_API_SERVER_URL is set to http://airflow-webserver:8080/execution/ because without it the worker looks for the API on localhost and fails."}, {"id": "airflow_docker_compose_jwt_secret", "label": "Shared JWT secret (AIRFLOW__API_AUTH__JWT_SECRET)", "file_type": "rationale", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 17-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same AIRFLOW_JWT_SECRET must be present in every container (api-server, scheduler, dag-processor); otherwise Execution API calls fail with InvalidSignatureError."}, {"id": "airflow_docker_compose_simple_auth_manager", "label": "SimpleAuthManager users/passwords file", "file_type": "rationale", "source_file": "airflow/docker-compose.yaml", "source_location": "lines 12-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Airflow 3 SimpleAuthManager: AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS grants the admin role to AIRFLOW_ADMIN_USERNAME, and passwords are read from /opt/airflow/auth/passwords.json (bind-mounted ./auth) which airflow-init generates at bootstrap."}, {"id": "airflow_docker_compose_localexecutor", "label": "LocalExecutor", "file_type": "concept", "source_file": "airflow/docker-compose.yaml", "source_location": "line 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AIRFLOW__CORE__EXECUTOR=LocalExecutor: tasks execute as subprocesses of the scheduler, avoiding a Celery/worker cluster for this single-host learning setup."}, {"id": "airflow_docker_compose_fantaf1_database_url", "label": "FANTAF1_DATABASE_URL (bridge to FantaF1 Django DB)", "file_type": "concept", "source_file": "airflow/docker-compose.yaml", "source_location": "line 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passed through from the host .env so DAGs in ./dags can reach the FantaF1 application database, which is separate from the Airflow metadata postgres."}], "edges": [{"source": "airflow_docker_compose_airflow_init", "target": "airflow_docker_compose_airflow_common", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "airflow/docker-compose.yaml", "source_location": "line 44 (<<: *airflow-common)", "weight": 1.0}, {"source": "airflow_docker_