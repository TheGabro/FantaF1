# ============================================================================
# Airflow Metadata Database (Postgres interno ad Airflow, solo per metadati)
# ============================================================================
POSTGRES_USER=airflow-fantaf1
POSTGRES_PASSWORD=changeme_airflow_password
POSTGRES_DB=airflow-fantaf1

# ============================================================================
# Airflow Admin User (credenziali per il login nella UI web, localhost:8080)
# ============================================================================
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changeme_admin_password
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ============================================================================
# FantaF1 Django Database (Postgres esterno: Neon in prod, locale per test)
# Questo è quello che i container usano per eseguire manage.py
# ============================================================================
FANTAF1_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================================================
# Airflow UID (per il corretto ownership dei file/log dentro i container)
# Su Linux/Mac: esegui `id -u` nel terminale e metti il risultato qui
# Su macOS con Docker Desktop: di solito è 501
# ============================================================================
AIRFLOW_UID=501

# ============================================================================
# JWT secret condiviso fra api-server, scheduler e dag-processor.
# Devono avere TUTTI lo stesso valore, altrimenti le chiamate interne
# (Execution API, log serving) falliscono con InvalidSignatureError.
# ============================================================================
AIRFLOW_JWT_SECRET=genera_con_python3_-c_"import secrets; print(secrets.token_hex(32))"

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme
